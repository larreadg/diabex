# Copiá este archivo como .env y completá con los datos de tu proyecto de Supabase.
# La publishable key (sb_publishable_...) es segura para el frontend.
# NUNCA uses la secret key (sb_secret_...) en el código del cliente.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
